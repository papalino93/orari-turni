// Schema dati per "orari-turni": griglia orari settimanale + copertura,
// area titolare con ferie/permessi. Vedi ONBOARDING/memoria di progetto
// per il contesto delle decisioni.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// I due account con pieni permessi (titolare + persona di fiducia).
// Nessun login per i singoli dipendenti.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  // Incrementata ad ogni cambio password (vedi account/actions.ts). Il JWT
  // di una sessione già aperta porta con sé la versione vista al login: se
  // non corrisponde più a questa, lib/auth.ts tratta quella sessione come
  // scaduta — è così che cambiare password toglie davvero l'accesso a chi
  // ha già una sessione valida, invece di lasciarlo dentro fino alla
  // scadenza naturale del token (fino a 30 giorni).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

enum EmployeeRole {
  EMPLOYEE
  OWNER
}

// Il titolare è un Employee con role OWNER: compare in griglia orari e
// copertura come chiunque altro, ma è escluso da ogni logica di ferie/permessi.
model Employee {
  id        String       @id @default(cuid())
  name      String
  role      EmployeeRole @default(EMPLOYEE)
  jobTitle  String? // etichetta libera, es. "Responsabile sala" — solo descrittiva
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  // Valorizzato quando esiste una foto: permette a liste e griglie di sapere
  // se mostrare l'avatar-foto (e con quale versione, per la cache) senza mai
  // caricare i byte dell'immagine insieme all'anagrafica.
  photoUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Area Dipendenti: login personale, creato in automatico alla creazione
  // del dipendente (vedi lib/employee-credentials.ts). password è cifrata
  // (non hash) perché il titolare deve poterla rileggere in ogni momento
  // dalla scheda del dipendente — scelta deliberata, non un hash "debole".
  // deactivatedAt segna il confine oltre il quale un dipendente disattivato
  // smette di vedere/compilare (resta in lettura fino a quella data compresa).
  username      String?   @unique
  password      String?
  // Stessa logica di User.tokenVersion: incrementata ad ogni cambio o
  // rigenerazione della password del dipendente (e quando il ruolo passa a
  // OWNER, che revoca le credenziali) — invalida qualunque sessione
  // dell'Area Dipendenti già aperta con la versione precedente.
  tokenVersion  Int       @default(0)
  deactivatedAt DateTime?
  // Permesso, assegnato dal titolare, di modificare il menù pubblico (vedi
  // /gestione-menu). Letto dal database a ogni richiesta — mai dal token —
  // così revocarlo ha effetto immediato anche su una sessione già aperta.
  canEditMenu   Boolean   @default(false)

  photo               EmployeePhoto?
  shiftBlocks         ShiftBlock[]
  leaveEntries        LeaveEntry[]
  leaveBalances       LeaveBalance[]
  monthlySubmissions  MonthlySubmission[]

  @@index([role])
}

// Foto profilo del dipendente, tabella separata così i byte non pesano mai
// sulle query di elenco. Ridimensionata lato client a un quadrato piccolo
// (vedi lib/photo.ts): sta comodamente in Postgres, nessun servizio esterno.
model EmployeePhoto {
  employeeId String   @id
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  data       Bytes
  mimeType   String
  updatedAt  DateTime @updatedAt
}

// Un blocco di presenza in un giorno (orario libero, più blocchi per
// giorno per gestire orari spezzati: es. 9-13 e 16-20 lo stesso giorno).
model ShiftBlock {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  startTime  String // "HH:MM", 24h
  endTime    String // "HH:MM", 24h
  confirmed  Boolean  @default(false) // il titolare ha verificato che l'orario pianificato corrisponde a quello realmente lavorato
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Area Dipendenti — revisione mensile: il dipendente corregge l'orario
  // stesso invece di tenere un valore "ore effettive" separato (un solo
  // numero vero in tutta l'app, vedi actions del mese). Se la correzione
  // cambia un orario già pianificato dal titolare, il valore originale si
  // salva qui la prima volta — non ad ogni modifica successiva — per poter
  // mostrare "era 9:00–13:00, ora 9:00–13:30" a chi approva.
  addedByEmployee    Boolean   @default(false)
  originalStartTime  String?
  originalEndTime    String?
  editedByEmployeeAt DateTime?

  @@index([date])
  @@index([employeeId, date])
}

enum LeaveType {
  FERIE
  PERMESSO
  LIBERO // riposo: il locale è aperto ma il dipendente non lavora. Non conta su ferie/permessi.
  MALATTIA // assenza per malattia: non consuma né ferie né permessi
}

// Un giorno di ferie, permesso o "libero" pianificato/goduto per un
// dipendente. FERIE: quantity in giorni (es. 1, 0.5). PERMESSO: quantity
// in ore. LIBERO: quantity non significativa (0), serve solo a
// distinguere "giorno di riposo confermato" da "non ancora pianificato".
// FERIE/PERMESSO non esistono per dipendenti con role OWNER (esclusi
// dalla logica ferie); LIBERO è disponibile per chiunque.
model LeaveEntry {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  type       LeaveType
  quantity   Float
  note       String?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, type, date])
}

// Giornata in cui il locale non apre affatto. È un fatto della giornata, non
// del singolo dipendente: per questo vive in una tabella sua e non come
// LeaveType. "Locale chiuso" e "riposo" sono due concetti diversi — un
// giorno chiuso non genera riposi, non produce ore e non entra nella
// copertura. La chiusura vale solo per la data indicata: chiudere domenica
// 16 agosto non chiude tutte le domeniche.
//
// I turni eventualmente già inseriti su una data che viene chiusa NON
// vengono cancellati: restano nel database ignorati da ogni calcolo e
// tornano validi se la giornata viene riaperta (vedi closeDay/reopenDay).
model ClosureDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String? // es. "Ferragosto", "chiusura straordinaria" — solo descrittivo
  createdAt DateTime @default(now())
  createdBy String? // username di chi ha chiuso la giornata
}

// Stato di pubblicazione di una settimana. Assente o publishedAt null =
// bozza (l'orario si sta ancora preparando); publishedAt valorizzato =
// orario comunicato al personale. Da non confondere con la verifica delle
// ore passate, che vive su ShiftBlock.confirmed.
model WeekPlan {
  id          String    @id @default(cuid())
  weekStart   DateTime  @unique @db.Date // sempre un lunedì
  publishedAt DateTime?
  publishedBy String? // username di chi ha pubblicato
  updatedAt   DateTime  @updatedAt
}

enum SubmissionStatus {
  DRAFT // il dipendente sta ancora rivedendo, o non ha ancora iniziato
  SUBMITTED // inviato, in attesa che il titolare lo controlli
  APPROVED // approvato, non più modificabile dal dipendente
  REOPENED // il titolare l'ha rimandato indietro per una correzione
}

// Stato della revisione mensile del dipendente — vedi Area Dipendenti nel
// piano di progetto. Una riga per dipendente/mese: assente = il dipendente
// non ha ancora aperto quel mese (equivale a DRAFT ai fini del promemoria).
model MonthlySubmission {
  id           String            @id @default(cuid())
  employeeId   String
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year         Int
  month        Int // 1-12
  status       SubmissionStatus  @default(DRAFT)
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedBy   String? // username titolare/consulente
  reopenedAt   DateTime?
  reopenNote   String? // perché il titolare l'ha rimandato indietro
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([employeeId, year, month])
  @@index([employeeId])
}

// Saldo di partenza e tasso di maturazione per dipendente/tipo/anno.
// openingBalance: residuo portato dall'anno precedente (o dalla busta
// paga al momento dell'import iniziale). monthlyAccrualRate: giorni/mese
// (FERIE) o ore/mese (PERMESSO), dedotto dal contratto in busta paga.
// Se non esiste una riga per un dipendente, la sua area ferie/permessi
// resta semplicemente vuota (nessun dato ancora caricato).
model LeaveBalance {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType
  year               Int
  openingBalance     Float     @default(0)
  monthlyAccrualRate Float     @default(0)
  sourceNote         String? // es. "da busta paga luglio 2026"
  updatedAt          DateTime  @updatedAt

  @@unique([employeeId, leaveType, year])
}

enum MenuSectionKind {
  WINE // voci con calice/bottiglia/uvaggio
  FOOD // voci con descrizione e un solo prezzo
}

// Menù pubblico raggiungibile dal QR (/menu). Le sezioni principali sono
// fisse (Bollicine, Bianchi, Tartare…): si modificano solo i loro testi. I
// gruppi dentro una sezione e le voci invece cambiano di continuo.
model MenuSection {
  id           String          @id @default(cuid())
  slug         String          @unique
  label        String // etichetta nella barra di navigazione
  kicker       String // riga piccola sopra al titolo ("Vini", "Cucina")
  title        String
  kind         MenuSectionKind
  note         String?
  addonTitle   String? // titoletto dell'avviso (es. "Novità · Oli aromatizzati")
  addon        String? // testo dell'avviso a fondo sezione
  sortOrder    Int             @default(0)
  // Se valorizzato, è il menù speciale di un evento: non compare tra le sezioni
  // fisse del menù ma dentro la pagina dell'evento (vedi MenuPromo).
  promoId      String?         @unique
  promo        MenuPromo?      @relation(fields: [promoId], references: [id], onDelete: Cascade)
  // Predisposizione per una versione in altre lingue: oggi non usato.
  translations Json?

  groups MenuGroup[]
}

model MenuGroup {
  id           String      @id @default(cuid())
  sectionId    String
  section      MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title        String
  columns      Boolean     @default(false) // mostra le colonne calice/bottiglia
  sortOrder    Int         @default(0)
  deletedAt    DateTime? // eliminazione "morbida": recuperabile dallo storico
  translations Json?

  items MenuItem[]

  @@index([sectionId, sortOrder])
}

// Un vino o un piatto. Per i vini valgono priceGlassCents/priceBottleCents
// (null = non disponibile in quel formato, mostrato come "—"), per il resto
// priceCents. I prezzi sono in centesimi.
model MenuItem {
  id               String    @id @default(cuid())
  groupId          String
  group            MenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name             String
  sub              String?
  grapes           String?
  description      String?
  priceGlassCents  Int?
  priceBottleCents Int?
  priceCents       Int?
  // Più formati con il loro prezzo (es. birra 0,2 l · 0,4 l · Maß 1 l):
  // [{ "label": "0,4 l", "cents": 600 }]. Alternativo a priceCents.
  variants         Json?
  enomatic         Boolean   @default(false)
  // Codici dei 14 allergeni UE; allergensReviewed distingue "nessun
  // allergene" da "non ancora compilato" (vedi pagina /menu/allergeni).
  allergens         String[]  @default([])
  allergensReviewed Boolean   @default(false)
  // Giorno commerciale (YYYY-MM-DD, vedi lib/menu.ts) in cui la voce è stata
  // segnata esaurita: vale solo per quel giorno, così il ripristino è
  // automatico senza bisogno di un cron.
  soldOutDay       String?
  sortOrder        Int       @default(0)
  deletedAt        DateTime?
  translations     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([groupId, sortOrder])
}

enum MenuPromoKind {
  NOTICE // annuncio: titolo, testo, foto, date
  EVENT // come l'annuncio, più un menù speciale (una MenuSection collegata)
}

// Pagina promozionale ("In evidenza"): eventi e annunci a tempo. Le date sono
// giorni commerciali (YYYY-MM-DD, vedi lib/menu-format.ts): la locandina si
// vede da showFrom a endDate, il menù speciale solo da startDate a endDate.
model MenuPromo {
  id             String        @id @default(cuid())
  kind           MenuPromoKind
  slug           String        @unique // indirizzo della pagina: /menu/p/<slug>
  title          String
  label          String? // tipo libero mostrato sopra al titolo (es. "Degustazione", "Serata a tema")
  body           String?
  showFrom       String
  startDate      String
  endDate        String
  hidden         Boolean       @default(false) // forza "nascosto", qualunque sia la data
  imageUpdatedAt DateTime?
  imageWidth     Int?
  imageHeight    Int?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  image   MenuPromoImage?
  section MenuSection?

  @@index([endDate])
}

// Locandina: tabella separata, così i byte non pesano sulle liste (stessa idea
// di EmployeePhoto). Ridimensionata sul dispositivo prima del caricamento.
model MenuPromoImage {
  promoId   String    @id
  promo     MenuPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime  @updatedAt
}

// Impostazioni uniche del menù, chiave → testo. Oggi non ne esiste nessuna in uso
// (coperto e chiusura cucina sono diventati blocchi, vedi MenuBlock): la tabella
// resta per le prossime.
model MenuSetting {
  id    String @id
  value String
}

enum MenuBlockKind {
  TEXT // testo semplice, in corsivo (es. «La cucina chiude circa 40–50 minuti prima…»)
  PRICE // voce con prezzo (es. «Coperto € 1,00», «Servizio 10%»)
  NOTICE // avviso evidenziato in un riquadro (es. «Domenica cucina chiusa»)
}

enum MenuBlockPlacement {
  TOP // in cima al menù, sotto «In evidenza» e sopra la barra delle sezioni
  BOTTOM // in fondo al menù, sopra la legenda degli allergeni
  SECTIONS // sotto il titolo di una o più sezioni (anche menù speciali di eventi)
}

// Informazione da mostrare nel menù: coperto, chiusura cucina, avvisi, note.
// Si decide di che tipo è, dove compare e (facoltativo) in quali giorni. Le date
// sono giorni commerciali (YYYY-MM-DD, vedi lib/menu-format.ts).
model MenuBlock {
  id         String             @id @default(cuid())
  kind       MenuBlockKind
  label      String? // titoletto (TEXT, NOTICE) o nome della voce (PRICE, es. "Coperto")
  text       String? // testo (TEXT, NOTICE)
  priceCents Int? // solo PRICE
  placement  MenuBlockPlacement
  sectionIds String[]           @default([]) // solo SECTIONS: id delle MenuSection
  startDate  String?
  endDate    String?
  hidden     Boolean            @default(false)
  sortOrder  Int                @default(0)
  deletedAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([placement, sortOrder])
}

enum MenuChangeAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  SOLD_OUT
  AVAILABLE
  RESET_SOLD_OUT
}

// Registro delle modifiche al menù: chi, quando, cosa. before/after sono
// istantanee dei soli campi cambiati e permettono di ripristinare.
model MenuChange {
  id        String           @id @default(cuid())
  at        DateTime         @default(now())
  actorName String
  action    MenuChangeAction
  entity    String // "item" | "group" | "section" | "setting" | "promo" | "block"
  entityId  String
  label     String // nome leggibile della voce/gruppo al momento
  before    Json?
  after     Json?
  // Se valorizzato, questa riga è stata annullata dalla riga indicata.
  undoneById String?

  @@index([at])
}
